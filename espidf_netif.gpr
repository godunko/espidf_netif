with "config/espidf_netif_config.gpr";

with "espidf.gpr";

library project ESPIDF_NETIF is

   for Languages use ("Ada", "C");
   for Library_Name use "adaespidf_netif";
   for Library_Dir use ESPIDF.Crate_Library_Dir;
   for Object_Dir use ESPIDF.Crate_Object_Dir;
   for Source_Dirs use ("source");

   package Compiler renames ESPIDF.Compiler;

end ESPIDF_NETIF;
